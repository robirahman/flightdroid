{
  "name": "flightdroid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mobile web app that maps your flights from Gmail confirmation emails",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "airports": "node scripts/build-airports.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "6.3.289",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
